# Docker-specific environment variables
# You can override these values by creating a .env.local file

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=mcppassword
MYSQL_DATABASE=mcpdatabase
MYSQL_USER=mcpuser
MYSQL_PASSWORD=mcppassword

# MCP Server Configuration
MCP_PORT=3000
PHPMYADMIN_PORT=8080
MYSQL_PORT=3306
IS_REMOTE_MCP=true

# Remote MCP Secret Key
REMOTE_SECRET_KEY=docker-secret-key-change-in-production
