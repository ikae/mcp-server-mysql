# Development Dockerfile with hot reload
FROM node:22-alpine

# Install pnpm
RUN npm install -g pnpm

# Set the working directory
WORKDIR /app

# Copy package files first
COPY package.json pnpm-lock.yaml* ./

# Copy TypeScript configuration files (needed for build)
COPY tsconfig.json tsconfig.scripts.json ./

# Copy source code (needed for the prepare script)
COPY . .

# Install all dependencies (including dev dependencies)
# Skip the prepare script to avoid build issues in development
RUN pnpm install --frozen-lockfile --ignore-scripts

# Expose the port
EXPOSE 3000

# Use tsx for development with hot reload
CMD ["npm", "run", "dev"]
